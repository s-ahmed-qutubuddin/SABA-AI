# SABA environment template matched to the current local configuration.
# Keep real secrets in your private .env only.
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=assistant_db

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Kore
SABA_USER_ID=1

CREATOR_BRAND=AQUS-AIE
CREATOR_TITLE=AHMED QUTUBUDDIN SAAD AI ENGINEER
SABA_CREATOR_ACTIVATION_SECRET=
CREATOR_SESSION_TTL_SECONDS=1800
CLAP_ACTIVATION_ENABLED=true
CLAP_MIN_GAP_MS=120
CLAP_MAX_GAP_MS=950
CLAP_SENSITIVITY_PROFILE=medium

# LG ThinQ
LG_THINQ_PAT=
LG_THINQ_CLIENT_ID=
LG_THINQ_COUNTRY=IN
LG_THINQ_LANGUAGE=en-IN
LG_THINQ_BASE_URL=https://api-eic.lgthinq.com
LG_THINQ_TIMEOUT_SECONDS=12

# Samsung SmartThings
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_REDIRECT_URI=
SMARTTHINGS_TIMEOUT_SECONDS=12
SMARTTHINGS_TOKEN_EXPIRES_AT=0
SMARTTHINGS_TOKEN_FILE=.smartthings_tokens.json
SMARTTHINGS_BASE_URL=https://api.smartthings.com/v1

# General runtime
ELECTRICITY_TARIFF_PER_KWH=0
MAX_VOICE_CONNECTIONS=32
MAX_ACTIVATION_CONNECTIONS=32
VOICE_MAX_AUDIO_BYTES=262144
VOICE_MAX_TEXT_BYTES=32768
HTTP_RATE_LIMIT=120
HTTP_RATE_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SABA_PROJECT_ROOT=

# Clap hardening (local companion only)
CLAP_QUIET_RMS_MAX=0.025
CLAP_PEAK_THRESHOLD_MIN=0.12
CLAP_RMS_THRESHOLD_MIN=0.018
CLAP_CREST_MIN=3.0
CLAP_NOISE_MULTIPLIER=3.0
CLAP_PEAK_NOISE_MULTIPLIER=2.6

# IR / HomeMate
# No extra IR secrets are required in your current .env.
# The two AC remotes are represented in data/ir_devices.json and learned commands in data/ir_commands.json.
# Keep IR disabled until the actual HomeMate network transport is verified.

# Family authentication
SABA_ACCESS_CODE=
SABA_SESSION_SECRET=
SABA_SECURE_COOKIES=false
SABA_SESSION_TTL_SECONDS=2592000
